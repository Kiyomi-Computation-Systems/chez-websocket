#!r6rs ; -*- scheme -*-
(import (akku format manifest))

;; Development only: chez-cmark-gfm renders docs/ into the docs site (`make
;; site`). The library's own dependency, chez-http-server, is a submodule
;; under vendor/, so this manifest names no `depends` and the library is not
;; installed through Akku. Akku.lock is `akku lock`'s output for this file.
;; .akkuignore keeps `akku install` to chez-cmark-gfm alone.
(akku-package ("chez-websocket" "0.2.0")
  (synopsis "WebSocket (RFC 6455) for chez-http-server, in Chez Scheme")
  (authors "Kiyomi Computation Systems LLC")
  (homepage "https://github.com/Kiyomi-Computation-Systems/chez-websocket")
  (license "BSD-3-Clause")
  (depends/dev ("chez-cmark-gfm" "^2.0.0")))
