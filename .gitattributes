# Kept LF in every checkout, a Windows one with core.autocrlf included: sh
# cannot run a script with CRs, and the Autobahn gate's ratchet is a file of
# lines (its reader drops a CR before a LF all the same).
*.sh                         text eol=lf
tests/autobahn/fake/docker   text eol=lf
tests/autobahn/fake/ps       text eol=lf
tests/autobahn/verdicts.txt  text eol=lf

# Design records, the development ledger and the coding agents' instructions
# stay in the repository but out of release archives (git archive, GitHub's
# source tarballs).
/.plans        export-ignore
/.superpowers  export-ignore
/AGENTS.md     export-ignore
